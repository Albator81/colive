{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - CoLive{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h2 fw-bold">Espace Admin</h1>
                <p class="text-muted mb-0">Gérez les annonces et la communauté CoLive.</p>
            </div>
            <a href="{{ path('app_home') }}" class="btn btn-outline-dark rounded-pill">Retour au site</a>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                    <span class="text-muted small">Annonces en attente</span>
                    <span class="h2 fw-bold d-block text-warning">{{ pendingAnnounces|length }}</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                    <span class="text-muted small">Total Avis</span>
                    <span class="h2 fw-bold d-block">{{ reviews|length }}</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                    <span class="text-muted small">Statut Système</span>
                    <span class="h5 fw-bold d-block text-success"><span class="me-1">●</span>Opérationnel</span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h2 class="h5 fw-bold mb-4">Modération des annonces</h2>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Logement</th>
                        <th>Localisation</th>
                        <th>Prix</th>
                        <th>Propriétaire</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for announce in pendingAnnounces %}
                        <tr>
                            <td class="fw-bold">{{ announce.titre }}</td>
                            <td>{{ announce.ville }}</td>
                            <td><span class="badge bg-dark rounded-pill">{{ announce.prix }}€</span></td>
                            <td class="text-muted">{{ announce.utilisateur.email }}</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="{{ path('app_admin_announce_validate', {id: announce.id}) }}" class="btn btn-success btn-sm rounded-pill">Valider</a>
                                    <a href="{{ path('app_admin_announce_delete', {id: announce.id}) }}" class="btn btn-outline-danger btn-sm rounded-pill" onclick="return confirm('Supprimer ?')">Refuser</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Aucune annonce en attente de validation.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h2 class="h5 fw-bold mb-4">Derniers commentaires</h2>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Auteur</th>
                        <th>Commentaire</th>
                        <th>Note</th>
                        <th class="text-end">Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for review in reviews %}
                        <tr>
                            <td><strong>{{ review.utilisateur.prenom }}</strong></td>
                            <td class="fst-italic text-muted">"{{ review.commentaire }}"</td>
                            <td>
                                {% for i in 1..5 %}
                                    <i class="bi bi-star-fill {{ i <= review.note ? 'text-warning' : 'text-muted' }}"></i>
                                {% endfor %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_admin_review_delete', {id: review.id}) }}" class="btn btn-outline-danger btn-sm rounded-pill" onclick="return confirm('Supprimer cet avis ?')">Supprimer</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
