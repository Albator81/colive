<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        {% block stylesheets %}

        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 1080; width: 350px;">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {% set flash_class = (label == 'error') ? 'danger' : label %}
                    
                    <div class="alert alert-{{ flash_class }} alert-dismissible fade show shadow-lg" role="alert">
                        <div class="d-flex">
                            <div class="py-1">
                                {% if label == 'success' %}<i class="fa-solid fa-circle-check me-2"></i>{% endif %}
                                {% if label == 'danger' or label == 'error' %}<i class="fa-solid fa-triangle-exclamation me-2"></i>{% endif %}
                                {{ message }}
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    </body>

    <script>
        {% if app.user %}
            const eventSource = new EventSource("{{ mercure(app.user.notificationTopic)|escape('js') }}");
            eventSource.onmessage = event => {
                console.log(JSON.parse(event.data));
            }
        {% endif %}
    </script>
</html>
