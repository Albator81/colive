<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.4/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <link rel="stylesheet" href="{{ asset('styles/bootstrap-override.css') }}">

{% block stylesheets %}{% endblock %}

    </head>
    <body
        data-login-url="{{ path('app_login') }}"
        data-bot-ask-url="{{ path('app_bot_ask') }}"
        {% if app.user %}
data-user-id="{{ app.user.id }}"

            data-notif-sound="{{ asset('audio/notif.mp3') }}"
            data-mercure-url="{{ mercure(app.user.notificationTopic) }}"
            data-notif-see-url="{{ path('app_notification_see') }}"
            data-notif-clear-url="{{ path('app_notification_clear') }}"
        {% endif %}
{% block body_data %}{% endblock %}

    >
        <div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" id="flash-container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
{% set flash_class = (label == 'error') ? 'danger' : label %}

                    <div class="alert alert-{{ flash_class }} alert-dismissible fade show shadow-lg" role="alert">
                        <div class="d-flex">
                            <div class="py-1">
                                {% if label == 'success' %}<i class="fa-solid fa-circle-check me-2"></i>{% endif %}
                                {% if label == 'danger' or label == 'error' %}<i class="fa-solid fa-triangle-exclamation me-2"></i>{% endif %}
                                {{ message }}
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

{% if show_header|default(true) %}
	<nav class="user-navbar {{ header_transparent|default(false) ? 'transparent' : '' }}">
		<a href="{{ path('app_home') }}" id="nav-logo">
			<span>C</span>
			CoLive
		</a>
		<div class="header-buttons d-flex align-items-center gap-3">
			{% block btn_bot %}
				{% if app.user %}
					<a href="{{ path('app_bot') }}" class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:45px;height:45px;">
						<i class="bi bi-robot fs-5"></i>
					</a>
				{% endif %}
			{% endblock %}
			{% block btn_message %}
				{% if app.user %}
					<a href="{{ path('app_message') }}" class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center" title="Mes messages" style="width:45px;height:45px;">
						<i class="bi bi-chat-dots fs-5"></i>
					</a>
				{% endif %}
			{% endblock %}
			{% block btn_profile %}
				{% if app.user %}
					<a href="{{ path('app_profile') }}" class="d-flex align-items-center gap-2 bg-white border rounded-pill px-3 py-1 text-decoration-none text-dark">
						<img src="{{ app.user.avatar ?: 'https://ui-avatars.com/api/?name=' ~ app.user.prenom ~ '+' ~ app.user.nom ~ '&background=000&color=fff' }}" alt="Avatar" class="rounded-circle" style="width:32px;height:32px;object-fit:cover;">
						<span class="fw-semibold">{{ app.user.prenom }}</span>
					</a>
				{% else %}
					<a href="{{ path('app_login') }}" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">Se connecter</a>
				{% endif %}
			{% endblock %}
			{% block header_buttons %}{% endblock %}
		</div>
	</nav>
{% endif %}


        {% block body %}{% endblock %}

        {% if app.user %}
            {% set notSeenCount = app.user.notifications|filter(n => not n.isSeen)|length %}
            <div class="notification-container dropup">
                <button class="btn btn-notification dropdown-toggle" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-bell-fill"></i>
<span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger {% if notSeenCount == 0 %}d-none{% endif %}">{{ notSeenCount }}</span>

</button>

                <ul class="dropdown-menu dropdown-menu-end p-0" aria-labelledby="notifDropdown">
                    <li class="p-3 bg-light border-bottom rounded-top d-flex justify-content-between align-items-center">
                        <h6 class="dropdown-header p-0 m-0 text-dark fw-bold">Notifications</h6>
                        <button id="notifClear" class="btn btn-sm btn-outline-secondary">Tout clear</button>
                    </li>
                    <div id="notif-list-container" class="py-2">
                        {% for notif in app.user.notifications|sort((a, b) => b.timestamp <=> a.timestamp) %}
                            <li>
                                <a class="dropdown-item notif-item {{ notif.isSeen ? 'opacity-75' : '' }} px-3 py-2 d-flex flex-column" href="{{ notif.targetLink }}">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-primary notif-title">{% if not notif.isSeen %}<strong>*</strong>{% endif %} {{ notif.title }}</strong>
                                        <span class="text-muted small notif-timestamp">{{ notif.timestamp|date('d/m/Y H:i') }}</span>
                                    </div>
                                    <span class="text-muted small">{{ notif.content }}</span>
                                </a>
                            </li>
                        {% else %}
<li id="empty-notif-msg" class="text-center text-muted py-3">
	<small>Fin des notifications</small>
</li>

                        {% endfor %}
                    </div>
                </ul>
</div>

            <script src="{{ asset('js/base.js') }}"></script>
        {% endif %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.4/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}
	{% block importmap %}
		{{ importmap('app') }}
	{% endblock %}
{% endblock %}

    </body>
</html>