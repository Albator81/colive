<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<title>
	{% block title %}Welcome!
	{% endblock %}
</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="{{ asset('styles/bootstrap-override.css') }}">

<style>
	.btn-white-bg.btn-outline-danger {
		background-color: #fff;
	}
	.btn-white-bg.btn-outline-danger:hover {
		background-color: #dc3545;
		color: #fff;
	}
	.btn-white-bg.btn-outline-dark {
		background-color: #fff;
	}
	.btn-white-bg.btn-outline-dark:hover {
		background-color: #212529;
		color: #fff;
	}
</style>
{% block stylesheets %}{% endblock %}

</head>

{% set _bg_image = bg_image ?? true %}
<body class="{{ _bg_image ? '' : 'bg-white' }}" {% if _bg_image %} style="background: url('{{ _bg_image is same as(true) ? asset('img/home.png') : _bg_image }}') no-repeat center center fixed; background-size: cover;" {% endif %} data-login-url="{{ path('app_login') }}" data-bot-ask-url="{{ path('app_bot_ask') }}" {% if app.user %} data-user-id="{{ app.user.id }}" data-notif-sound="{{ asset('audio/notif.mp3') }}" data-mercure-url="{{ mercure(app.user.notificationTopic) }}" data-notif-see-url="{{ path('app_notification_see') }}" data-notif-clear-url="{{ path('app_notification_clear') }}" {% endif %} {% block body_data %} {% endblock %}></body>


<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3 z-3" id="flash-container">
	{% for label, messages in app.flashes %}
		{% for message in messages %}
			{% set flash_class = (label == 'error') ? 'danger' : label %}

<div class="alert alert-{{ flash_class }} alert-dismissible fade show shadow-lg" role="alert">
	<div class="d-flex">
		<div class="py-1">

{% if label == 'success' %}
	<i class="fa-solid fa-circle-check me-2"></i>
{% endif %}
{% if label == 'danger' or label == 'error' %}
	<i class="fa-solid fa-triangle-exclamation me-2"></i>
{% endif %}
{{ message }}</div></div><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{% endfor %}{% endfor %}</div>


{% if show_header ?? true %}
	<nav class="user-navbar navbar navbar-expand-lg px-4 py-2 sticky-top z-3 {{ (header_transparent ?? true) ? 'bg-transparent' : 'bg-white shadow-sm' }}">
	<a href="{{ path('app_home') }}" id="nav-logo" class="navbar-brand fw-bolder fs-2 text-dark text-decoration-none bg-white bg-opacity-75 rounded-pill px-4 shadow-sm" style="backdrop-filter: blur(10px);">
		CoLive
	</a>


<div class="header-buttons d-flex align-items-center gap-3 ms-auto">
	{% if (show_btn_bot ?? true) and app.user %}
		<a href="{{ path('app_bot') }}" class="btn btn-light rounded-circle p-2 lh-1 d-flex align-items-center justify-content-center shadow-sm">
			<i class="bi bi-robot fs-5 m-1"></i>
		</a>
	{% endif %}

{% if (show_btn_message ?? true) and app.user %}
	<a href="{{ path('app_message') }}" class="btn btn-light rounded-circle p-2 lh-1 d-flex align-items-center justify-content-center shadow-sm">
		<i class="bi bi-chat-dots fs-5 m-1"></i>
	</a>
{% endif %}

{% if (show_btn_profile ?? true) and app.user %}
	<a href="{{ path('app_profile') }}" class="d-flex align-items-center gap-2 bg-white border rounded-pill px-3 py-1 text-decoration-none text-dark shadow-sm">
		<img src="{{ app.user.avatar ?: 'https://ui-avatars.com/api/?name=' ~ app.user.prenom ~ '+' ~ app.user.nom ~ '&background=000&color=fff' }}" alt="Avatar" width="32" height="32" class="rounded-circle object-fit-cover">
		<span class="fw-semibold">{{ app.user.prenom }}</span>
	</a>

{% endif %}

{% if (show_btn_logout ?? false) and app.user %}
	<a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-white-bg rounded-pill px-4 fw-semibold shadow-sm">Se déconnecter</a>
{% endif %}

{% if (show_btn_login ?? true) and not app.user %}
	<a href="{{ path('app_login') }}" class="btn btn-outline-dark btn-white-bg rounded-pill px-4 fw-semibold shadow-sm">Se connecter</a>
{% endif %}

{% block header_buttons %}{% endblock %}</div></nav>{% endif %}


<main>
	{% block body %}{% endblock %}

</main>


{% if (show_btn_notif ?? true) and app.user %}
	{% set notSeenCount = app.user.notifications|filter(n => not n.isSeen)|length %}

<div class="notification-container dropup position-fixed bottom-0 end-0 p-4 z-3">
	<button class="btn btn-dark rounded-circle shadow-lg p-3 lh-1 position-relative d-flex align-items-center justify-content-center" type="button" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" onmouseenter="this.classList.replace('btn-dark', 'btn-light')" onmouseleave="this.classList.replace('btn-light', 'btn-dark')">
		<i class="bi bi-bell-fill fs-4 m-1"></i>
		<span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light {% if notSeenCount == 0 %}d-none{% endif %}">{{ notSeenCount }}</span>
	</button>


<ul class="dropdown-menu dropdown-menu-end p-0 shadow-lg border-0 mb-2 overflow-y-auto" aria-labelledby="notifDropdown" style="width: 320px; max-height: 400px;">
	<li class="p-3 bg-light border-bottom rounded-top d-flex justify-content-between align-items-center sticky-top">
		<h6 class="dropdown-header p-0 m-0 text-dark fw-bold">Notifications</h6>
		<button id="notifClear" class="btn btn-sm btn-outline-secondary">Tout clear</button>
	</li>
	<div id="notif-list-container" class="py-2">
		{% for notif in app.user.notifications|sort((a, b) => b.timestamp <=> a.timestamp) %}
			<li></li>

<a class="dropdown-item notif-item {{ notif.isSeen ? 'opacity-75' : 'bg-light' }} px-3 py-2 d-flex flex-column border-bottom" href="{{ notif.targetLink }}">
	<div class="d-flex justify-content-between align-items-center mb-1">

<strong class="text-primary notif-title text-truncate me-2">
	{% if not notif.isSeen %}
		<span class="text-danger fw-bold">*</span>
	{% endif %}
	{{ notif.title }}
</strong>
<span class="text-muted small notif-timestamp text-nowrap">{{ notif.timestamp|date('d/m/Y H:i') }}</span></div>

<span class="text-muted small text-wrap">{{ notif.content }}</span></a></li>{% else %}

<li id="empty-notif-msg" class="text-center text-muted py-4">
	<i class="bi bi-bell-slash fs-3 d-block mb-2 opacity-50"></i>
	<small>Aucune notification</small>
</li>

{% endfor %}</div></ul></div>

<script src="{{ asset('js/base.js') }}"></script>{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}
	{% block importmap %}
		{{ importmap('app') }}
	{% endblock %}
{% endblock %}

</body>

</html>