{% extends 'base.html.twig' %}

{% set bg_image = false %}
{% set header_transparent = false %}
{% set show_btn_logout = true %}
{% set show_btn_bot = true %}
{% set show_btn_message = true %}
{% set show_btn_notif = true %}
{% set show_btn_profile = false %}

{% block title %}Mon Profil - CoLive
{% endblock %}

{% block body %}
	<div class="container py-5">
		<div class="mb-5">
			<h1 class="fw-bold display-6">Mon Profil</h1>
			<p class="text-muted lead">Gérez vos informations personnelles et vos annonces.</p>
		</div>
		<div class="row g-4">
			<div class="col-lg-4">
				<div class="card border shadow-sm rounded-4 p-4 text-center">
					<div class="mb-3 position-relative d-inline-block mx-auto">
						{% if user.avatar %}
							<img src="{{ user.avatar }}" alt="Avatar" class="rounded-circle shadow-sm object-fit-cover" width="140" height="140">
						{% else %}
							<img src="https://ui-avatars.com/api/?name={{ user.prenom }}+{{ user.nom }}&background=000&color=fff&size=140" alt="Avatar" class="rounded-circle shadow-sm" width="140">
						{% endif %}
					</div>

					{% if nbNotes != 0 %}
						<a href="{{ path('app_host_reviews', {'id': user.id}) }}" class="text-decoration-none text-dark d-block mb-3">
							<div class="text-warning mb-1">
								{% for i in 1..5 %}
									<i class="bi bi-star{{ i <= averageRating ? '-fill' : '' }}"></i>
								{% endfor %}
							</div>
							<small class="fw-bold text-muted">({{ nbNotes }}
								avis)</small>
						</a>
					{% endif %}

					<h2 class="h4 fw-bold mb-1">{{ user.prenom }}
						{{ user.nom }}</h2>
					<p class="text-muted small mb-4">Membre depuis
						{{ user.dateCreationCompte|date('Y') }}</p>

					<div class="text-start border-top pt-4 mb-4">
						<div class="d-flex align-items-center gap-3 mb-3">
							<div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:35px; height:35px;">
								<i class="bi bi-envelope small"></i>
							</div>
							<span class="text-truncate small fw-semibold">{{ user.email }}</span>
						</div>
						<div class="d-flex align-items-center gap-3">
							<div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center" style="width:35px; height:35px;">
								<i class="bi bi-telephone small"></i>
							</div>
							<span class="small fw-semibold">{{ user.tel|default('Non renseigné') }}</span>
						</div>
					</div>

					<div class="row g-0 border-top pt-4">
						<div class="col-6 border-end">
							<div class="h5 fw-bold mb-0">{{ user.annonces|length }}</div>
							<div class="text-muted" style="font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase;">Annonces</div>
						</div>
						<div class="col-6">
							<div class="h5 fw-bold mb-0">{{ user.likes|length }}</div>
							<div class="text-muted" style="font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase;">Favoris</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-lg-8">
				<div class="card border shadow-sm rounded-4">
					<div class="card-header bg-white border-0 p-3">
						<ul class="nav nav-pills nav-fill gap-2" id="profileTabs">
							<li class="nav-item">
								<button class="nav-link active rounded-pill fw-bold" data-bs-toggle="pill" data-bs-target="#tab-infos">Informations</button>
							</li>
							<li class="nav-item">
								<button class="nav-link rounded-pill fw-bold" data-bs-toggle="pill" data-bs-target="#tab-annonces">Mes annonces</button>
							</li>
							<li class="nav-item">
								<button class="nav-link rounded-pill fw-bold" data-bs-toggle="pill" data-bs-target="#tab-favoris">Réservations</button>
							</li>
						</ul>
					</div>

					<div class="card-body p-4 tab-content">
						<div class="tab-pane fade show active" id="tab-infos">
							<h3 class="h5 fw-bold mb-4">Informations personnelles</h3>
							{{ form_start(form) }}
							<div class="mb-4 p-3 bg-light rounded-3 border border-dashed">
								{{ form_label(form.avatarFile, 'Photo de profil', {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
								{{ form_widget(form.avatarFile, {'attr': {'class': 'form-control border-0 bg-white'}}) }}
								<div class="text-danger small mt-1">{{ form_errors(form.avatarFile) }}</div>
							</div>
							<div class="row g-3 mb-3">
								<div class="col-md-6">
									{{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
									{{ form_widget(form.prenom, {'attr': {'class': 'form-control rounded-3 py-2'}}) }}
								</div>
								<div class="col-md-6">
									{{ form_label(form.nom, null, {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
									{{ form_widget(form.nom, {'attr': {'class': 'form-control rounded-3 py-2'}}) }}
								</div>
							</div>
							<div class="mb-3">
								{{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
								{{ form_widget(form.email, {'attr': {'class': 'form-control rounded-3 py-2'}}) }}
							</div>
							<div class="mb-4">
								{{ form_label(form.tel, null, {'label_attr': {'class': 'form-label fw-bold small text-muted'}}) }}
								{{ form_widget(form.tel, {'attr': {'class': 'form-control rounded-3 py-2'}}) }}
							</div>
							<button type="submit" class="btn btn-dark rounded-pill px-5 fw-bold shadow-sm py-2">Mettre à jour</button>
							{{ form_end(form) }}

							<div class="mt-5 pt-4 border-top">
								<h4 class="h6 fw-bold text-danger mb-3">Zone de danger</h4>
								<div class="p-3 border border-danger rounded-4 bg-danger bg-opacity-10 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
									<p class="small mb-0 fw-medium">La suppression de votre compte est définitive et irréversible.</p>
									<form method="post" action="{{ path('app_profile_delete') }}" onsubmit="return confirm('Confirmer la suppression du compte ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
										<button type="submit" class="btn btn-danger btn-sm rounded-pill px-3 fw-bold">Supprimer mon compte</button>
									</form>
								</div>
							</div>
						</div>

						<div class="tab-pane fade" id="tab-annonces">
							<div class="d-flex justify-content-between align-items-center mb-4">
								<h3 class="h5 fw-bold mb-0">Mes annonces</h3>
								<a href="{{ path('app_announce_create') }}" class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-bold">Nouvelle +</a>
							</div>
							{% for announce in user.annonces %}
								<div class="d-flex align-items-center gap-3 p-3 border rounded-4 mb-3 shadow-sm bg-white">
									<img src="{{ announce.photos|length > 0 ? announce.photos|first.contenu : 'https://via.placeholder.com/80' }}" class="rounded-3 object-fit-cover" width="85" height="85">
									<div class="flex-grow-1">
										<h4 class="h6 fw-bold mb-1">{{ announce.titre }}</h4>
										<div class="small text-muted mb-2">{{ announce.ville }}
											•
											{{ announce.prix }}€/mois</div>
										<div class="d-flex gap-2">
											<span class="badge bg-success bg-opacity-10 text-success rounded-pill fw-bold" style="font-size: 0.65rem;">ACTIF</span>
											<span class="badge bg-danger bg-opacity-10 text-danger rounded-pill fw-bold d-flex align-items-center gap-1" style="font-size: 0.65rem;">
												<i class="bi bi-heart-fill"></i>
												{{ announce.likes|length }}
											</span>
										</div>
									</div>
									<div class="text-end d-flex flex-column gap-2">
										<a href="{{ path('app_announce_edit', {'id': announce.id}) }}" class="btn btn-light btn-sm rounded-pill fw-bold border py-1 px-3">Modifier</a>
										<form method="post" action="{{ path('app_announce_delete', {'id': announce.id}) }}" onsubmit="return confirm('Supprimer l\'annonce ?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ announce.id) }}">
											<button type="submit" class="btn btn-link btn-sm text-danger text-decoration-none p-0 fw-bold small">Supprimer</button>
										</form>
									</div>
								</div>
							{% else %}
								<div class="text-center py-5 text-muted small">Aucune annonce publiée.</div>
							{% endfor %}
						</div>

						<div class="tab-pane fade" id="tab-favoris">
							<h3 class="h5 fw-bold mb-4">Mes réservations</h3>
							{% for reservation in user.reservations|default([]) %}
								{% set isFinished = reservation.dateFin < date() and reservation.statut == 'CONFIRMED' %}
								<div class="p-3 border rounded-4 mb-3 shadow-sm {{ (reservation.statut == 'CANCELLED' or isFinished) ? 'bg-light opacity-50' : 'bg-white' }}">
									<div class="row align-items-center g-3">
										<div class="col-auto">
											<img src="{{ reservation.announce.photos|length > 0 ? reservation.announce.photos|first.contenu : 'https://via.placeholder.com/70' }}" class="rounded-3 object-fit-cover" width="70" height="70">
										</div>
										<div class="col">
											<h4 class="h6 fw-bold mb-1">{{ reservation.announce.titre }}</h4>
											<div class="small text-muted mb-2">
												<i class="bi bi-calendar3 me-1"></i>Du
												{{ reservation.dateDebut|date('d/m/Y') }}
												au
												{{ reservation.dateFin|date('d/m/Y') }}</div>
											<div class="d-flex gap-2 align-items-center">
												{% set statusColor = reservation.statut == 'PENDING' ? 'warning' : (reservation.statut == 'CONFIRMED' ? (isFinished ? 'secondary' : 'success') : 'danger') %}
												<span class="badge bg-{{ statusColor }} bg-opacity-10 text-{{ statusColor }} rounded-pill" style="font-size: 0.65rem;">{{ reservation.statut }}</span>
												<span class="small fw-bold">{{ reservation.announce.prix }}
													€/mois</span>
											</div>
										</div>
										<div class="col-md-auto text-md-end">
											{% if reservation.statut != 'CANCELLED' and not isFinished %}
												<form method="post" action="{{ path('app_reservation_cancel', {'id': reservation.id}) }}" onsubmit="return confirm('Annuler ?');">
													<input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">
													<button type="submit" class="btn btn-outline-danger btn-sm rounded-pill fw-bold">Annuler</button>
												</form>
											{% endif %}
										</div>
									</div>
								</div>
							{% else %}
								<div class="text-center py-4 text-muted small">Aucune réservation.</div>
							{% endfor %}

							<h3 class="h5 fw-bold mt-5 mb-4">Mes favoris</h3>
							<div class="row g-3">
								{% for like in user.likes %}
									<div class="col-12">
										<div class="d-flex align-items-center gap-3 p-2 border rounded-4 bg-white shadow-sm">
											<img src="{{ like.annonce.photos|length > 0 ? like.annonce.photos|first.contenu : 'https://via.placeholder.com/60' }}" class="rounded-3 object-fit-cover" width="60" height="60">
											<div class="flex-grow-1">
												<h4 class="h6 fw-bold mb-0 text-truncate" style="max-width: 200px;">{{ like.annonce.titre }}</h4>
												<small class="text-muted">{{ like.annonce.ville }}</small>
											</div>
											<button class="btn btn-light rounded-circle border-0 shadow-sm me-2" onclick="toggleLike(event, {{ like.annonce.id }})">
												<i class="bi bi-heart-fill text-danger"></i>
											</button>
										</div>
									</div>
								{% else %}
									<div class="text-center py-4 text-muted small w-100">Aucun favori.</div>
								{% endfor %}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/profile_index.js') }}"></script>
{% endblock %}
