{% extends 'base.html.twig' %}

{% set bg_image = true %}
{% set header_transparent = true %}
{% set show_btn_notif = true %}

{% block title %}CoLive – Accueil
{% endblock %}

{% block body %}
	<div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 z-n1" style="backdrop-filter: blur(3px);"></div>
	<div class="d-flex flex-column justify-content-center align-items-center text-center px-4" style="min-height: 80vh;">
		<div class="text-white mb-5" style="max-width:800px;">
			<h1 class="display-3 fw-bold mb-3">La cohabitation pensée pour les étudiants en alternance</h1>
			<p class="lead mb-4">CoLive connecte les étudiants en alternance pour partager des logements. Trouvez votre colocataire idéal ou proposez votre espace.</p>
			<a href="{{ path('app_announce_create') }}" class="btn btn-light btn-lg rounded-pill px-5 fw-bold">
				Proposer mon logement
				<i class="bi bi-arrow-right-circle-fill ms-2"></i>
			</a>
		</div>

		<div class="bg-white rounded-pill p-2 shadow-lg w-100" style="max-width:1050px;">
			<form action="{{ path('app_announce') }}" method="get" class="d-flex align-items-center">
				<div class="flex-fill px-3 py-2">
					<label for="location" class="small fw-bold text-dark text-uppercase">Destination</label>
					<input type="text" id="location" name="location" class="form-control border-0 p-0" placeholder="Ville, école...">
				</div>
				<div class="vr"></div>
				<div class="flex-fill px-3 py-2">
					<label for="date_start" class="small fw-bold text-dark text-uppercase">Arrivée</label>
					<input type="date" id="date_start" name="date_start" class="form-control border-0 p-0">
				</div>
				<div class="vr"></div>
				<div class="flex-fill px-3 py-2">
					<label for="date_end" class="small fw-bold text-dark text-uppercase">Départ</label>
					<input type="date" id="date_end" name="date_end" class="form-control border-0 p-0">
				</div>
				<div class="vr"></div>
				<div class="flex-fill px-3 py-2">
					<label for="type" class="small fw-bold text-dark text-uppercase">Type</label>
					<select name="type" id="type" class="form-select border-0 p-0">
						<option value="all">Tout</option>
						<option value="Chambre">Chambre</option>
						<option value="Collocation">Collocation</option>
						<option value="Studio">Studio</option>
					</select>
				</div>
				<div class="vr"></div>
				<div class="flex-fill px-3 py-2">
					<label for="prix_max" class="small fw-bold text-dark text-uppercase">Budget max</label>
					<input type="number" id="prix_max" name="prix_max" class="form-control border-0 p-0" placeholder="€">
				</div>
				<div class="vr"></div>
				<div class="flex-fill px-3 py-2">
					<label for="equipement" class="small fw-bold text-dark text-uppercase">Équipement</label>
					<select name="equipement" id="equipement" class="form-select border-0 p-0">
						<option value="">Tous</option>
						{% for equip in equipment %}
							<option value="{{ equip.id }}">{{ equip.nom }}</option>
						{% endfor %}
					</select>
				</div>
				<button type="submit" class="btn btn-dark rounded-pill px-4 py-2 fw-bold ms-2">
					<i class="bi bi-search"></i>
				</button>
			</form>
		</div>
	</div>

{% endblock %}
