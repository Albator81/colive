{% extends 'base.html.twig' %}

{% set bg_image = false %}
{% set header_transparent = false %}
{% set show_btn_bot = false %}

{% block title %}Assistant CoLive
{% endblock %}

{% block body %}
<div class="container-fluid px-0" style="height: calc(100vh - 74px);">
<div class="row g-0 h-100">
<div class="col-12 h-100">
<div class="card border-0 shadow-lg rounded-0 d-flex flex-column h-100">
<div class="card-header bg-dark text-white p-3 border-0">
<div class="d-flex align-items-center gap-3">
<div class="bg-light text-dark rounded-circle p-2 lh-1 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width:40px;height:40px;">
<i class="bi bi-robot fs-5"></i>
</div>
<div>
<h3 class="h6 fw-bold mb-0">Assistant CoLive</h3>
<small class="opacity-75">En ligne (IA)</small>
</div>
</div>
</div>
<div class="card-body overflow-auto d-flex flex-column gap-3 p-4 bg-light" id="chatBox">
<div class="d-flex justify-content-start gap-2 align-items-center">
<div class="bg-light text-dark rounded-circle p-2 lh-1 d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width:40px;height:40px;">
<i class="bi bi-robot fs-5"></i>
</div>
<div class="d-flex flex-column align-items-start w-75">
<div class="p-3 rounded-4 shadow-sm bg-white border rounded-bottom-start-0">
<p class="mb-0">Bonjour ! Je suis l'IA de CoLive. Une question sur le site ?</p>
</div>
</div>
</div>
</div>

<div class="card-footer p-3 bg-white border-0 shadow-sm">
<div class="input-group">
<input type="text" id="userInput" class="form-control rounded-start-pill py-2 ps-4" placeholder="Posez votre question...">
<button class="btn btn-dark rounded-end-pill px-4 fw-bold" onclick="sendMessage()">Envoyer</button>
</div>
</div>
</div>
</div>
</div>
</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/bot_index.js') }}"></script>
{% endblock %}
