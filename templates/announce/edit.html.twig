{% extends 'base.html.twig' %}

{% set bg_image = true %}
{% set header_transparent = true %}
{% set show_btn_bot = true %}
{% set show_btn_message = true %}
{% set show_btn_profile = true %}
{% set show_btn_notif = true %}
{% set show_btn_logout = false %}
{% set show_btn_login = false %}

{% block title %}Modifier l'annonce - {{ annonce.titre }}{% endblock %}

{% block body %}
    <div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 z-n1" style="backdrop-filter: blur(5px);"></div>
    <div class="container py-5" style="max-width:850px;">
        <div class="text-center mb-5 text-white">
            <h1 class="fw-bold display-5">Modifier l'annonce</h1>
            <p class="lead opacity-75">{{ annonce.titre }}</p>
        </div>

        {{ form_start(formAnnonce) }}

        <div class="card border-0 shadow-lg rounded-4 mb-4 p-4 p-md-5">
            <h4 class="fw-bold mb-1">Informations de base</h4>
            <p class="text-muted small mb-4">Mettez à jour les détails principaux de votre logement</p>

            <div class="row g-4">
                <div class="col-md-6 d-flex flex-column gap-3">
                    <div>
                        <label class="form-label fw-bold">Titre de l'annonce</label>
                        {{ form_widget(formAnnonce.titre, {'attr': {'class': 'form-control form-control-lg rounded-3 bg-light border-0'}}) }}
                    </div>
                    <div>
                        <label class="form-label fw-bold">Type de logement</label>
                        {{ form_widget(formAnnonce.type, {'attr': {'class': 'form-select form-select-lg rounded-3 bg-light border-0'}}) }}
                    </div>
                    <div>
                        <label class="form-label fw-bold">Nombre de pièces</label>
                        {{ form_widget(formAnnonce.nb_pieces, {'attr': {'class': 'form-control form-control-lg rounded-3 bg-light border-0'}}) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Description</label>
                    {{ form_widget(formAnnonce.description, {'attr': {'class': 'form-control rounded-3 bg-light border-0', 'style': 'height: 100%; min-height: 200px; resize: none;'}}) }}
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-lg rounded-4 mb-4 p-4 p-md-5">
            <h4 class="fw-bold mb-1">Photos</h4>
            <p class="text-muted small mb-3">Gérez les visuels de votre annonce</p>

            <div class="mb-4">
                <label class="form-label fw-bold small text-uppercase text-muted mb-3">Photos actuelles</label>
                <div class="d-flex gap-3 flex-wrap" id="existing-photos">
                    {% for photo in annonce.photos %}
                        <div class="position-relative group" id="photo-{{ photo.id }}">
                            <img src="{{ photo.contenu }}" class="rounded-3 shadow-sm" style="width:120px;height:120px;object-fit:cover;">
                            <button type="button" class="btn btn-danger btn-sm rounded-circle position-absolute top-0 end-0 m-1 shadow" onclick="deleteExistingPhoto({{ photo.id }})" style="width:28px;height:28px;padding:0;">
                                <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
                            </button>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <label class="form-label fw-bold small text-uppercase text-muted mb-3">Ajouter de nouvelles photos</label>
            <div class="d-none">{{ form_widget(formAnnonce.images) }}</div>
            <div class="border border-2 border-dashed rounded-4 p-5 text-center bg-light" id="drop-zone" style="cursor: pointer;">
                <div class="bg-white rounded-circle shadow-sm d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-plus-lg fs-4 text-primary"></i>
                </div>
                <p class="text-muted small mb-0 fw-bold">Cliquez ou glissez vos nouvelles images ici</p>
                <div id="preview-container" class="d-flex gap-3 flex-wrap mt-4 justify-content-center"></div>
            </div>
        </div>

        <div class="card border-0 shadow-lg rounded-4 mb-4 p-4 p-md-5">
            <h4 class="fw-bold mb-1">Localisation</h4>
            <div class="mb-3 mt-3">
                <label class="form-label fw-bold">Adresse</label>
                {{ form_widget(formAnnonce.adresse, {'attr': {'class': 'form-control form-control-lg rounded-3 bg-light border-0'}}) }}
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Ville</label>
                    {{ form_widget(formAnnonce.ville, {'attr': {'class': 'form-control form-control-lg rounded-3 bg-light border-0'}}) }}
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Code postal</label>
                    {{ form_widget(formAnnonce.code_postal, {'attr': {'class': 'form-control form-control-lg rounded-3 bg-light border-0'}}) }}
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-lg rounded-4 mb-4 p-4 p-md-5">
            <h4 class="fw-bold mb-1">Tarification & Surface</h4>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Surface (m²)</label>
                    <div class="input-group input-group-lg">
                        {{ form_widget(formAnnonce.surface, {'attr': {'class': 'form-control rounded-start-3 bg-light border-0'}}) }}
                        <span class="input-group-text bg-light border-0 rounded-end-3">m²</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Prix par mois</label>
                    <div class="input-group input-group-lg">
                        {{ form_widget(formAnnonce.prix, {'attr': {'class': 'form-control rounded-start-3 bg-light border-0'}}) }}
                        <span class="input-group-text bg-light border-0 rounded-end-3">€</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-lg rounded-4 mb-4 p-4 p-md-5">
            <h4 class="fw-bold mb-1">Détails & Disponibilité</h4>
            <p class="text-muted small mb-4">Équipements, règles et calendrier</p>
            
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Équipements standards</label>
                        {{ form_widget(formAnnonce.equipment, {'attr': {'data-controller': 'tom-select'}}) }}
                    </div>
                    <div>
                        <label class="form-label fw-bold">Mes équipements personnalisés</label>
                        {{ form_widget(formAnnonce.userEquipments, {'attr': {'data-controller': 'tom-select', 'data-tom-select-create-url-value': path('app_equipment_create')}}) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Règles de vie</label>
                    {{ form_widget(formAnnonce.regle, {'attr': {'class': 'form-control rounded-3 bg-light border-0', 'style': 'height: 125px; resize: none;'}}) }}
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Disponible du</label>
                    {{ form_widget(formAnnonce.disponibilite_debut, {'attr': {'class': 'form-control form-control-lg rounded-3 bg-light border-0'}}) }}
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Au</label>
                    {{ form_widget(formAnnonce.disponibilite_fin, {'attr': {'class': 'form-control form-control-lg rounded-3 bg-light border-0'}}) }}
                </div>
            </div>
        </div>

        <div class="text-center mt-5 mb-5">
            <button type="submit" class="btn btn-light btn-lg fw-bold px-5 py-3 rounded-pill shadow-lg">
                <i class="bi bi-check-circle-fill me-2"></i>
                Enregistrer les modifications
            </button>
        </div>

        {{ form_end(formAnnonce) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/announce_edit.js') }}"></script>
{% endblock %}