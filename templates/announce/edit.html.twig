{% extends 'base.html.twig' %}

{% block title %}Modifier l'annonce - {{ annonce.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% set show_header = false %}

{% block body %}
    <div class="bg-dark min-vh-100 py-4">
        <div class="container" style="max-width:800px;">
            <div class="mb-4 d-flex justify-content-between align-items-center">
                <a href="{{ path('app_profile') }}" class="text-decoration-none">
                    <span class="bg-white text-dark rounded-2 px-2 fw-bold fs-5">C</span>
                </a>
                <h2 class="text-white fw-bold m-0">Modifier l'annonce</h2>
            </div>

            {{ form_start(formAnnonce) }}

            <div class="card rounded-4 mb-4 p-4">
                <h5 class="fw-bold mb-3">Informations de base</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Titre</label>
                            {{ form_widget(formAnnonce.titre, {'attr': {'class': 'form-control rounded-3'}}) }}
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Type</label>
                            {{ form_widget(formAnnonce.type, {'attr': {'class': 'form-select rounded-3'}}) }}
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-bold">Nombre de pièces</label>
                            {{ form_widget(formAnnonce.nb_pieces, {'attr': {'class': 'form-control rounded-3'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Description</label>
                        {{ form_widget(formAnnonce.description, {'attr': {'class': 'form-control rounded-3', 'style': 'height: 14rem; resize: none;'}}) }}
                    </div>
                </div>
            </div>

            <div class="card rounded-4 mb-4 p-4">
                <h5 class="fw-bold mb-3">Photos</h5>
                <p class="text-muted small">Photos enregistrées:</p>
                <div class="d-flex gap-3 flex-wrap mb-4" id="existing-photos">
                    {% for photo in annonce.photos %}
                        <div class="position-relative" id="photo-{{ photo.id }}">
                            <img src="{{ photo.contenu }}" class="rounded-3" style="width:100px;height:100px;object-fit:cover;">
                            <button type="button" class="position-absolute top-0 end-0 btn btn-danger btn-sm rounded-circle" onclick="deleteExistingPhoto({{ photo.id }})">&times;</button>
                        </div>
                    {% endfor %}
                </div>

                <p class="text-muted small">Ajouter de nouvelles photos :</p>
                <div class="d-none">{{ form_widget(formAnnonce.images) }}</div>
                <div class="border border-2 border-dashed rounded-4 p-4 text-center" id="drop-zone">
                    <p class="text-muted mb-0">Cliquez ici pour sélectionner des images</p>
                    <div id="preview-container" class="d-flex gap-2 flex-wrap mt-3"></div>
                </div>
            </div>

            <div class="card rounded-4 mb-4 p-4">
                <h5 class="fw-bold mb-3">Localisation</h5>
                <div class="mb-3">
                    <label class="form-label fw-bold">Adresse</label>
                    {{ form_widget(formAnnonce.adresse, {'attr': {'class': 'form-control rounded-3'}}) }}
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ville</label>
                        {{ form_widget(formAnnonce.ville, {'attr': {'class': 'form-control rounded-3'}}) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Code postal</label>
                        {{ form_widget(formAnnonce.code_postal, {'attr': {'class': 'form-control rounded-3'}}) }}
                    </div>
                </div>
            </div>

            <div class="card rounded-4 mb-4 p-4">
                <h5 class="fw-bold mb-3">Tarification & Surface</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Surface (m²)</label>
                        {{ form_widget(formAnnonce.surface, {'attr': {'class': 'form-control rounded-3'}}) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Prix par mois (€)</label>
                        {{ form_widget(formAnnonce.prix, {'attr': {'class': 'form-control rounded-3'}}) }}
                    </div>
                </div>
            </div>

            <div class="card rounded-4 mb-4 p-4">
                <h5 class="fw-bold mb-3">Détails supplémentaires</h5>
                <div class="mb-3">
                    <label class="form-label fw-bold">Équipements</label>
                    {{ form_widget(formAnnonce.equipment, {'attr': {'class': 'form-select rounded-3', 'style': 'height:120px;'}}) }}
                </div>
                <div class="mb-0">
                    <label class="form-label fw-bold">Règles</label>
                    {{ form_widget(formAnnonce.regle, {'attr': {'class': 'form-control rounded-3', 'style': 'height:100px;'}}) }}
                </div>
            </div>

            <div class="card rounded-4 mb-4 p-4">
                <h5 class="fw-bold mb-3">Disponibilité</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Du</label>
                        {{ form_widget(formAnnonce.disponibilite_debut, {'attr': {'class': 'form-control rounded-3'}}) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Au</label>
                        {{ form_widget(formAnnonce.disponibilite_fin, {'attr': {'class': 'form-control rounded-3'}}) }}
                    </div>
                </div>
            </div>

            <div class="text-center pb-5">
                <button type="submit" class="btn btn-light fw-bold px-5 py-3 rounded-pill shadow-lg">
                    <i class="bi bi-save"></i> Enregistrer les modifications
                </button>
            </div>

            {{ form_end(formAnnonce) }}
        </div>
    </div>

    <script src="{{ asset('js/announce_edit.js') }}"></script>
{% endblock %}
