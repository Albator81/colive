{% extends 'base.html.twig' %}

{# Configuration pour le base.html.twig #}
{% set bg_image = false %}
{% set header_transparent = false %}

{% block title %}Toutes nos annonces
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;900&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
	<div class="container-fluid py-4 px-lg-4">
		<div
			class="row g-4">

			{# Bouton d'affichage des filtres sur Mobile #}
			<div class="col-12 d-lg-none mb-2">
				<button class="btn btn-outline-dark w-100 d-flex justify-content-center align-items-center gap-2 rounded-pill shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarFilters" aria-expanded="false" aria-controls="sidebarFilters">
					<i class="bi bi-filter"></i>
					Afficher les filtres
				</button>
			</div>

			{# COLONNE GAUCHE : Filtres #}
			<aside class="col-12 col-lg-3 collapse d-lg-block" id="sidebarFilters">
				<div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 85px; z-index: 1;">
					<div class="card-header bg-white border-bottom-0 pt-4 pb-2">
						<h2 class="h5 fw-bold mb-0 text-dark">
							<i class="bi bi-sliders me-2"></i>Filtres</h2>
					</div>

					<div class="card-body">
						<form
							action="{{ path('app_announce') }}" method="get">

							{# Ville #}
							<div class="mb-4">
								<label for="location" class="form-label fw-semibold small text-uppercase text-muted">Ville</label>
								<input type="text" id="location" name="location" value="{{ app.request.query.get('location') }}" class="form-control rounded-3" placeholder="Ex: Paris">
							</div>

							{# Type de logement #}
							<div class="mb-4">
								<label class="form-label fw-semibold small text-uppercase text-muted">Type de logement</label>
								{% set currentFilter = app.request.query.get('type', 'all') %}

								<div class="d-flex flex-column gap-2">
									<div class="form-check">
										<input class="form-check-input" type="radio" id="type_all" name="type" value="all" {% if currentFilter == 'all' %} checked {% endif %}>
										<label class="form-check-label" for="type_all">Tout</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="radio" id="type_chambre" name="type" value="Chambre" {% if currentFilter == 'Chambre' %} checked {% endif %}>
										<label class="form-check-label" for="type_chambre">Chambre</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="radio" id="type_coloc" name="type" value="Collocation" {% if currentFilter == 'Collocation' %} checked {% endif %}>
										<label class="form-check-label" for="type_coloc">Collocation</label>
									</div>
									<div class="form-check">
										<input class="form-check-input" type="radio" id="type_studio" name="type" value="Studio" {% if currentFilter == 'Studio' %} checked {% endif %}>
										<label class="form-check-label" for="type_studio">Studio</label>
									</div>
								</div>
							</div>

							{# Période #}
							<div class="mb-4">
								<label class="form-label fw-semibold small text-uppercase text-muted">Période</label>
								<div class="row g-2">
									<div class="col-12 col-xl-6">
										<label class="form-label small mb-1">Arrivée</label>
										<input type="date" name="date_start" class="form-control form-control-sm rounded-3" value="{{ app.request.query.get('date_start') }}">
									</div>
									<div class="col-12 col-xl-6">
										<label class="form-label small mb-1">Départ</label>
										<input type="date" name="date_end" class="form-control form-control-sm rounded-3" value="{{ app.request.query.get('date_end') }}">
									</div>
								</div>
							</div>

							{# Prix #}
							<div class="mb-4">
								<label class="form-label fw-semibold small text-uppercase text-muted">Prix (€/mois)</label>
								<div class="row g-2">
									<div class="col-6">
										<input type="number" name="prix_min" class="form-control rounded-3" value="{{ app.request.query.get('prix_min') }}" placeholder="Min">
									</div>
									<div class="col-6">
										<input type="number" name="prix_max" class="form-control rounded-3" value="{{ app.request.query.get('prix_max') }}" placeholder="Max">
									</div>
								</div>
							</div>

							{# Surface #}
							<div class="mb-4">
								<label class="form-label fw-semibold small text-uppercase text-muted">Surface min. (m²)</label>
								<input type="number" name="surface" class="form-control rounded-3" value="{{ app.request.query.get('surface') }}" placeholder="Ex: 15">
							</div>

							{# Équipements #}
							<div class="mb-4">
								<label class="form-label fw-semibold small text-uppercase text-muted">Équipements</label>
								<select name="equipement" class="form-select rounded-3">
									<option value="">Tous</option>
									{% for equip in equipment %}
										<option value="{{ equip.id }}" {% if app.request.query.get('equipement') == equip.id %} selected {% endif %}>
											{{ equip.nom }}
										</option>
									{% endfor %}
								</select>
							</div>

							<hr class="text-muted opacity-25">

							<div class="d-grid gap-2">
								<button type="submit" class="btn btn-dark fw-bold rounded-pill shadow-sm">
									Voir les résultats
								</button>
								<a href="{{ path('app_announce') }}" class="btn btn-outline-danger btn-white-bg fw-bold rounded-pill shadow-sm">
									Réinitialiser les filtres
								</a>
							</div>

						</form>
					</div>
				</div>
			</aside>

			{# COLONNE DROITE : Grille d'annonces #}
			<section class="col-12 col-lg-9">

				<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
					<h1 class="h3 fw-bold text-dark mb-0">
						Toutes nos annonces
						{% if app.request.query.get('type') != 'all' and app.request.query.get('type') is not empty %}
							<span class="text-primary">de
								{{ app.request.query.get('type') }}</span>
						{% endif %}
					</h1>
				</div>

				{# Le container pour le JS #}
				<div
					class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" id="grid-announces" data-user-id="{{ app.user ? app.user.id : '' }}" data-login-url="{{ path('app_login') }}">{# Les annonces seront injectées ici par ton script JS #}
				</div>

			</section>

		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/announce_index.js') }}"></script>
{% endblock %}
