{% extends 'base.html.twig' %}

{% block title %}Toutes nos annonces{% endblock %}

{% set show_header = true %}
{% set header_transparent = false %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block body %}

<div class="bg-light min-vh-100 py-4">
    <div class="container-fluid px-4 px-lg-5">
        <div class="row">
            <!-- Filtres Sidebar -->
            <div class="col-12 col-md-3 mb-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 sticky-top" style="top:90px;">
                    <h5 class="fw-bold mb-3"><i class="bi bi-funnel me-2"></i>Filtres</h5>

                    <form action="{{ path('app_announce') }}" method="get">
                        <div class="mb-3">
                            <label for="location" class="form-label fw-bold">Ville</label>
                            <input type="text" id="location" name="location" value="{{ app.request.query.get('location') }}" class="form-control rounded-3" placeholder="Ex: Paris">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Type de logement</label>
                            {% set currentFilter = app.request.query.get('type', 'all') %}
                            <div class="d-flex flex-wrap gap-2">
                                <input type="radio" id="type_all" name="type" value="all" class="btn-check" {% if currentFilter == 'all' %}checked{% endif %}>
                                <label for="type_all" class="btn btn-outline-dark btn-sm rounded-pill">Tout</label>

                                <input type="radio" id="type_chambre" name="type" value="Chambre" class="btn-check" {% if currentFilter == 'Chambre' %}checked{% endif %}>
                                <label for="type_chambre" class="btn btn-outline-dark btn-sm rounded-pill">Chambre</label>

                                <input type="radio" id="type_coloc" name="type" value="Collocation" class="btn-check" {% if currentFilter == 'Collocation' %}checked{% endif %}>
                                <label for="type_coloc" class="btn btn-outline-dark btn-sm rounded-pill">Collocation</label>

                                <input type="radio" id="type_studio" name="type" value="Studio" class="btn-check" {% if currentFilter == 'Studio' %}checked{% endif %}>
                                <label for="type_studio" class="btn btn-outline-dark btn-sm rounded-pill">Studio</label>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Arrivée</label>
                                <input type="date" name="date_start" class="form-control form-control-sm rounded-3" value="{{ app.request.query.get('date_start') }}">
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Départ</label>
                                <input type="date" name="date_end" class="form-control form-control-sm rounded-3" value="{{ app.request.query.get('date_end') }}">
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold small">Prix min (€)</label>
                                <input type="number" name="prix_min" class="form-control form-control-sm rounded-3" value="{{ app.request.query.get('prix_min') }}" placeholder="Min">
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small">Prix max (€)</label>
                                <input type="number" name="prix_max" class="form-control form-control-sm rounded-3" value="{{ app.request.query.get('prix_max') }}" placeholder="Max">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Surface min (m²)</label>
                            <input type="number" name="surface" class="form-control form-control-sm rounded-3" value="{{ app.request.query.get('surface') }}" placeholder="Surface">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Équipement</label>
                            <select name="equipement" class="form-select form-select-sm rounded-3">
                                <option value="">Tous</option>
                                {% for equip in equipment %}
                                    <option value="{{ equip.id }}" {% if app.request.query.get('equipement') == equip.id %}selected{% endif %}>
                                        {{ equip.nom }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark rounded-pill">Voir les résultats</button>
                            <a href="{{ path('app_announce') }}" class="btn btn-link text-secondary text-decoration-none">Réinitialiser</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Liste Annonces -->
            <div class="col-12 col-md-9">
                <h1 class="h3 fw-bold mb-4">Toutes nos annonces{% if app.request.query.get('type') != 'all' %} de {{ app.request.query.get('type') }}{% endif %}</h1>

                <div class="row g-4" id="grid-announces">
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{ asset('js/announce_index.js') }}"></script>
{% endblock %}
