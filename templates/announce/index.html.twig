{% extends 'base.html.twig' %}

{% block title %}Toutes nos annonces{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/announce_index.css') }}">

{% endblock %}

{% block body %}

    <div class="main-wrapper">

        <header class="header-nav">
            <a href="{{ path('app_home') }}" class="header-logo">
                CoLive
            </a>

            {% if app.user %}
                <a href="{{ path('app_profile') }}" class="nav-user-pill">
                    {% if app.user.avatar %}
                        <img src="{{ app.user.avatar }}" alt="Avatar" class="nav-avatar-mini">
                    {% else %}
                        <img src="https://ui-avatars.com/api/?name={{ app.user.prenom }}+{{ app.user.nom }}&background=000&color=fff&size=256&font-size=0.33" alt="Avatar" class="nav-avatar-mini">
                    {% endif %}
                    <span>{{ app.user.prenom }}</span>
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="nav-login-btn">
                    Se connecter
                </a>
            {% endif %}
        </header>

        <div class="filter-overlay" id="overlay" onclick="toggleMenu()"></div>

        <aside class="filter-sidebar" id="sidebar">
            <div class="sidebar-header">
                <h2 class="sidebar-title">Filtres</h2>
                <button class="btn-close" onclick="toggleMenu()">&times;</button>
            </div>

            <form action="{{ path('app_announce') }}" method="get">
                <div>
                    <label for="location" class="form-label">Ville</label>
                    <input type="text" id="location" name="location" value="{{ app.request.query.get('location') }}" class="form-input" placeholder="Ex: Paris">
                </div>

                <div class="spacer desktop-hidden"></div>

                <fieldset class="form-fieldset">
                    <legend class="form-legend">Type de logement</legend>

                    {% set currentFilter = app.request.query.get('type', 'all') %}

                    <div>
                        <input type="radio" id="type_all" name="type" value="all" class="radio-hidden"
                               {% if currentFilter == 'all' %}checked{% endif %}>
                        <label for="type_all" class="radio-text-label">Tout</label>
                    </div>

                    <div>
                        <input type="radio" id="type_chambre" name="type" value="Chambre" class="radio-hidden"
                               {% if currentFilter == 'Chambre' %}checked{% endif %}>
                        <label for="type_chambre" class="radio-text-label">Chambre</label>
                    </div>

                    <div>
                        <input type="radio" id="type_coloc" name="type" value="Collocation" class="radio-hidden"
                               {% if currentFilter == 'Collocation' %}checked{% endif %}>
                        <label for="type_coloc" class="radio-text-label">Collocation</label>
                    </div>

                    <div>
                        <input type="radio" id="type_studio" name="type" value="Studio" class="radio-hidden"
                               {% if currentFilter == 'Studio' %}checked{% endif %}>
                        <label for="type_studio" class="radio-text-label">Studio</label>
                    </div>

                </fieldset>

                <div class="spacer desktop-hidden"></div>

                <fieldset class="form-fieldset">
                    <legend class="form-legend">Période</legend>
                    <div class="date-range-wrapper">
                        <label class="form-label">Arrivée</label>
                        <input type="date" name="date_start" class="form-input" value="{{ app.request.query.get('date_start') }}">
                    </div>
                    <div>
                        <label class="form-label">Départ</label>
                        <input type="date" name="date_end" class="form-input" value="{{ app.request.query.get('date_end') }}">
                    </div>
                </fieldset>

                <div class="spacer desktop-hidden"></div>

                <fieldset class="form-fieldset">
                    <legend class="form-legend">Prix (€/mois)</legend>
                    <div class="price-range-wrapper">
                        <div>
                            <label class="form-label">Min</label>
                            <input type="number" name="prix_min" class="form-input" value="{{ app.request.query.get('prix_min') }}" placeholder="Prix minimum">
                        </div>
                        <div>
                            <label class="form-label">Max</label>
                            <input type="number" name="prix_max" class="form-input" value="{{ app.request.query.get('prix_max') }}" placeholder="Prix maximum">
                        </div>
                    </div>
                </fieldset>

                <div class="spacer desktop-hidden"></div>

                <fieldset class="form-fieldset">
                    <legend class="form-legend">Surface (m²)</legend>
                    <div>
                        <label class="form-label">Min</label>
                        <input type="number" name="surface" class="form-input" value="{{ app.request.query.get('surface') }}" placeholder="Surface minimum">
                    </div>
                </fieldset>

                <div class="spacer desktop-hidden"></div>

                <fieldset class="form-fieldset">
                    <legend class="form-legend">Équipements</legend>
                    <div>
                        <select name="equipement" class="form-input">
                            <option value="">Tous</option>
                            {% for equip in equipment %}
                                <option value="{{ equip.id }}" {% if app.request.query.get('equipement') == equip.id %}selected{% endif %}>
                                    {{ equip.nom }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </fieldset>

                <button type="submit" class="btn-submit">Voir les résultats</button>

                <a href="{{ path('app_announce') }}" class="btn-reset-filters">
                    Réinitialiser les filtres
                </a>
            </form>
        </aside>

        <section>
            <div class="page-header-container">
                <h1 class="page-title">Toutes nos annonces
                {% if app.request.query.get('type') != 'all' %}
                    de {{ app.request.query.get('type') }}
                {% endif %}
                </h1>

                <button class="btn-filter-text" onclick="toggleMenu()">
                    <i class="bi bi-filter"></i> Filtres
                </button>
            </div>

            <div class="pinterest-grid" id="grid-announces">
            </div>
        </section>

    </div>

    <script src="{{ asset('js/announce_index.js') }}"></script>
    <script>
        async function create_cards() {
            try {
                const urlParams = new URLSearchParams(window.location.search);

                const apiParams = new URLSearchParams();

                const locationParam = urlParams.get('location');
                const typeParam = urlParams.get('type');
                const dateStart = urlParams.get('date_start');
                const dateEnd = urlParams.get('date_end');

                const prixMin = urlParams.get('prix_min');
                const prixMax = urlParams.get('prix_max');
                const surface = urlParams.get('surface');
                const equipement = urlParams.get('equipement');

                if (locationParam) {
                    apiParams.append('ville', locationParam);
                }

                if (typeParam && typeParam !== 'all') {
                    apiParams.append('type', typeParam);
                }

                if (dateStart) {
                    apiParams.append('disponibilite_debut[after]', dateStart);
                }

                if (dateEnd) {
                    apiParams.append('disponibilite_fin[before]', dateEnd);
                }

                if (prixMin) {
                    apiParams.append('prix[gte]', prixMin);
                }

                if (prixMax) {
                    apiParams.append('prix[lte]', prixMax);
                }

                if (surface) {
                    apiParams.append('surface[gte]', surface);
                }

                if (equipement) {
                    apiParams.append('equipment', equipement);
                }

                const apiURL = `/api/announces?${apiParams.toString()}`;

                const response = await fetch(apiURL);
                const data = await response.json();
                const announceData = data.member || [];
                const userId = {{ app.user ? app.user.id : 'null' }};
                
                const announceGrid = document.getElementById('grid-announces');
                announceGrid.innerHTML = '';

                if (announceData.length === 0) {
                    announceGrid.innerHTML = '<p>Aucune annonce n\'a été trouvée.</p>';
                    return;
                }

                announceData.forEach(announce => {
                    let isLiked = false;

                    announce.likes.forEach(like => {
                        if (like.utilisateur.id == userId) {
                            isLiked = true;
                        }
                    });

                    const photoUrl = (announce.photos && announce.photos.length > 0) ? announce.photos[0].contenu : `https://picsum.photos/seed/${announce.id}/400/600`;

                    let dateHtml = '';
                    
                    const start = new Date(announce.disponibilite_debut).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
                    const end = new Date(announce.disponibilite_fin).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
                    dateHtml = `<p class="card-date">${start} - ${end}</p>`;

                    const announceHtml = `
                        <article class="announce-card" onclick="window.location.href='/announce/${announce.id}'">
                            <button class="card-like-btn ${isLiked ? 'liked' : ''}" 
                                    onclick="toggleLike(event, ${announce.id})">
                                <i class="bi ${isLiked ? 'bi-heart-fill' : 'bi-heart'}"></i>
                            </button>

                            <img src="${photoUrl}" class="card-img" alt="${announce.titre}">

                            <div class="card-content">
                                <h2 class="card-title">${announce.titre}</h2>
                                <p class="card-location"><i class="bi bi-geo-alt-fill"></i> ${announce.ville}</p>
                                ${dateHtml}
                                <div class="card-price">${announce.prix}€ <small>/mois</small></div>
                            </div>
                        </article>
                    `;

                    announceGrid.innerHTML += announceHtml;
                });
            } catch (error) {
                console.log(error);
                document.getElementById('grid-announces').innerHTML = '<p>Erreur lors du chargement des annonces.</p>';
            }
        }

        create_cards();
    </script>
{% endblock %}
