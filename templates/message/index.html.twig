{% extends 'base.html.twig' %}

{% set bg_image = false %}
{% set header_transparent = false %}
{% set show_btn_bot = true %}
{% set show_btn_profile = true %}
{% set show_btn_notif = true %}
{% set show_btn_message = false %}

{% block title %}Messagerie
{% endblock %}

{% block body %}
	<div class="container-fluid px-0" style="height: calc(100vh - 74px);">
		<div class="row g-0 h-100">
			<div class="col-md-4 col-lg-3 border-end bg-light d-flex flex-column h-100">
				<div class="p-3 border-bottom bg-white shadow-sm z-1">
					<h2 class="h5 fw-bold mb-3">Messagerie</h2>
					<form action="{{ path('app_message') }}" method="get">
						<input type="text" name="q" value="{{ searchTerm }}" class="form-control rounded-pill bg-light border-0 px-3 py-2" placeholder="Rechercher un contact...">
					</form>
				</div>
				<div class="p-3 overflow-auto flex-grow-1">
					<h3 class="small fw-bold text-muted mb-3 text-uppercase">Mes Discussions ({{ users|length }})</h3>
					<div class="list-group list-group-flush gap-2" id="contactListContainer">
						{% for user in users %}
							<a href="{{ path('app_message_conversation', {id: user.id}) }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3 rounded-4 border-0 p-3 shadow-sm {% if selectedUser and selectedUser.id == user.id %}bg-dark text-white{% else %}bg-white{% endif %}">
								<div class="{% if selectedUser and selectedUser.id == user.id %}bg-white text-dark{% else %}bg-dark text-white{% endif %} rounded-circle d-flex justify-content-center align-items-center flex-shrink-0 fw-bold" style="width:45px;height:45px;">
									{{ user.prenom|first|upper }}
								</div>
								<div class="overflow-hidden">
									<div class="fw-bold text-truncate">{{ user.prenom }}
										{{ user.nom }}</div>
									<small class="{% if selectedUser and selectedUser.id == user.id %}text-light opacity-75{% else %}text-muted{% endif %} d-block text-truncate">Voir la conversation</small>
								</div>
							</a>
						{% endfor %}
					</div>
				</div>
			</div>

			<div class="col-md-8 col-lg-9 d-flex flex-column h-100">
				{% if selectedUser %}
					<div class="p-3 border-bottom bg-white shadow-sm z-1 d-flex align-items-center gap-3">
						<div class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center fw-bold flex-shrink-0" style="width:45px;height:45px;">
							{{ selectedUser.prenom|first|upper }}
						</div>
						<h3 class="h5 fw-bold mb-0">{{ selectedUser.prenom }}
							{{ selectedUser.nom }}</h3>
						<a href="{{ path('app_contact_remove', {id: selectedUser.id}) }}" class="btn btn-outline-danger rounded-circle ms-auto d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
							<i class="bi bi-trash"></i>
						</a>
					</div>

					<div class="flex-grow-1 p-4 overflow-auto d-flex flex-column gap-3" id="messagesArea" style="background:#f8f9fa;">
						{% for message in messages %}
							<div class="d-flex {% if message.sender.id == app.user.id %}justify-content-end{% else %}justify-content-start gap-2{% endif %}">
								{% if message.sender.id != app.user.id %}
									<div class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center flex-shrink-0 fw-bold mt-auto mb-4" style="width:35px;height:35px;">
										{{ message.sender.prenom|first|upper }}
									</div>
								{% endif %}

								<div class="d-flex flex-column {% if message.sender.id == app.user.id %}align-items-end{% else %}align-items-start{% endif %}" style="max-width:75%;">
									<div class="p-3 rounded-4 shadow-sm {% if message.sender.id == app.user.id %}bg-dark text-white rounded-bottom-end-0{% else %}bg-white border rounded-bottom-start-0{% endif %}">
										{% if message.attachment %}
											<div class="mb-2">
												<img src="{{ asset('uploads/' ~ message.attachment) }}" class="img-fluid rounded-3 shadow-sm" style="max-height:250px;object-fit:cover;">
											</div>
										{% endif %}

										{% if "[RES_ID:" in message.content %}
											{% set resId = message.content|split('[RES_ID:')[1]|split(']')[0] %}
											{% set cleanContent = message.content|split(']')|last %}
											{% if message.sender.id == app.user.id %}
												<div class="small fw-bold mb-1 text-info">
													<i class="bi bi-send-check me-1"></i>Demande envoyée</div>
												<p class="mb-0">{{ cleanContent }}</p>
											{% else %}
												<div class="badge bg-warning text-dark mb-2 px-3 py-2 rounded-pill shadow-sm">
													<i class="bi bi-megaphone me-1"></i>Demande reçue</div>
												<p class="mb-3">{{ cleanContent }}</p>
												<div class="d-flex gap-2">
													<a href="{{ path('app_reservation_accept', {id: resId}) }}" class="btn btn-success btn-sm rounded-pill px-3 fw-bold shadow-sm">Accepter</a>
													<a href="{{ path('app_reservation_reject', {id: resId}) }}" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold shadow-sm" onclick="return confirm('Refuser cette demande ?')">Refuser</a>
												</div>
											{% endif %}
										{% elseif "[RES_ACCEPT]" in message.content %}
											<div class="text-success fw-bold">
												<i class="bi bi-check-circle-fill me-1"></i>
												{{ message.content|replace({'[RES_ACCEPT]': ''}) }}</div>
										{% elseif "[RES_REJECT]" in message.content %}
											<div class="text-danger fw-bold">
												<i class="bi bi-x-circle-fill me-1"></i>
												{{ message.content|replace({'[RES_REJECT]': ''}) }}</div>
										{% else %}
											<p class="mb-0">{{ message.content }}</p>
										{% endif %}
									</div>
									<small class="text-muted mt-1 px-2" style="font-size: 0.75rem;">{{ message.createdAt|date('H:i') }}</small>
								</div>
							</div>
						{% endfor %}
					</div>

					<div class="p-3 bg-white border-top shadow-sm z-1">
						<form method="post" class="d-flex gap-2 align-items-center" enctype="multipart/form-data">
							<label for="file-upload" class="btn btn-light rounded-circle p-2 d-flex align-items-center justify-content-center border" style="width:45px;height:45px;cursor:pointer;">
								<i class="bi bi-paperclip fs-5"></i>
							</label>
							<input type="file" name="file_upload" id="file-upload" class="d-none" accept="image/*">
							<input type="text" name="content" class="form-control form-control-lg rounded-pill bg-light border-0 px-4" placeholder="Écrivez votre message..." required autofocus>
							<input type="hidden" name="_token" value="{{ csrf_token('message_send') }}">
							<button type="submit" class="btn btn-dark rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width:45px;height:45px;">
								<i class="bi bi-send-fill"></i>
							</button>
						</form>
					</div>
				{% else %}
					<div class="d-flex flex-column align-items-center justify-content-center flex-grow-1 text-center p-4 bg-light h-100">
						<div class="bg-white p-5 rounded-4 shadow-sm">
							<i class="bi bi-chat-dots-fill display-1 text-secondary mb-3 opacity-50"></i>
							<h4 class="fw-bold text-dark">Vos messages</h4>
							<p class="text-muted mb-0">Sélectionnez une discussion pour commencer à discuter.</p>
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/message_index.js') }}"></script>
{% endblock %}
