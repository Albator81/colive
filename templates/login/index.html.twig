{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% set show_header = false %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="min-vh-100 d-flex align-items-center justify-content-center position-relative" style="background:url('{{ asset('img/home.png') }}') center/cover no-repeat;">
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50"></div>

        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white position-relative" style="max-width:400px;width:90%;">
            <div class="text-center mb-4">
                <div class="bg-dark text-white rounded-3 d-inline-flex justify-content-center align-items-center" style="width:50px;height:50px;font-weight:bold;font-size:1.5rem;">C</div>
                <h2 class="h4 fw-bold mt-3">Connexion</h2>
                <p class="text-muted">Heureux de vous revoir !</p>
            </div>

            <form action="{{ path('app_login') }}" method="post">
                <div class="mb-3">
                    <label for="username" class="form-label fw-bold">Email</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}" class="form-control rounded-3" placeholder="votre.email@example.com" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label fw-bold">Mot de passe</label>
                    <input type="password" id="password" name="_password" class="form-control rounded-3" placeholder="......." required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {% if error %}
                    <div class="alert alert-danger rounded-3">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill mt-3">Se connecter</button>
            </form>

            <p class="text-center mt-4 mb-0">
                Pas encore de compte ? <a href="{{ path('app_registration') }}" class="fw-bold">S'inscrire</a>
            </p>
        </div>
    </div>
{% endblock %}
