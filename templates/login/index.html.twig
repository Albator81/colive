{% extends 'base.html.twig' %}

{% set show_header = false %}
{% set show_btn_notif = false %}
{% set bg_image = true %}

{% block title %}Se connecter
{% endblock %}

{% block body %}
	<div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 z-n1"></div>
	<div class="min-vh-100 d-flex align-items-center justify-content-center px-3">
		<div class="card border-0 shadow-lg rounded-4 p-4 bg-white w-100" style="max-width:400px;">
			<div class="text-center mb-4">
				<div class="bg-dark text-white rounded-3 d-inline-flex justify-content-center align-items-center mb-3" style="width:50px;height:50px;font-weight:bold;font-size:1.5rem;">C</div>
				<h2 class="h4 fw-bold">Connexion</h2>
				<p class="text-muted">Heureux de vous revoir !</p>
			</div>

			<form action="{{ path('app_login') }}" method="post">
				{% if error %}
					<div class="alert alert-danger rounded-3">
						{{ error.messageKey|trans(error.messageData, 'security') }}
					</div>
				{% endif %}

				<div class="mb-3">
					<label for="username" class="form-label fw-bold">Email</label>
					<input type="email" id="username" name="_username" value="{{ last_username }}" class="form-control rounded-3" placeholder="votre.email@example.com" required autofocus>
				</div>

				<div class="mb-3">
					<label for="password" class="form-label fw-bold">Mot de passe</label>
					<input type="password" id="password" name="_password" class="form-control rounded-3" placeholder="......." required>
				</div>

				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

				<button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill mt-3 fw-bold">Se connecter</button>
			</form>

			<p class="text-center mt-4 mb-0">
				Pas encore de compte ?
				<a href="{{ path('app_registration') }}" class="fw-bold text-dark">S'inscrire</a>
			</p>
		</div>
	</div>

{% endblock %}
