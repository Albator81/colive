{% extends 'base.html.twig' %}

{# Configuration pour header blanc et fond blanc #}
{% set bg_image = false %}
{% set header_transparent = false %}

{% block title %}Avis de
	{{ host.prenom }}
{% endblock %}

{% block body_data %}
	data-host-id="{{ host.id }}"
{% endblock %}

{% block body %}
	{# bg-white pour respecter ta consigne #}
	<div class="bg-white min-vh-100 py-5">
		<div
			class="container">

			<!-- Titre de la page -->
			<div class="mb-5">
				<a href="javascript:history.back()" class="text-decoration-none text-muted small fw-bold mb-2 d-inline-block">
					<i class="bi bi-arrow-left me-1"></i>Retour
				</a>
				<h1 class="h2 fw-bold">Profil et avis de
					{{ host.prenom }}</h1>
			</div>

			<div
				class="row g-4">
				<!-- Colonne Gauche : Carte Profil -->
				<div class="col-lg-4">
					<div class="card border shadow-sm rounded-4 p-4 text-center sticky-top" style="top: 100px;">
						<img src="{{ host.avatar ? host.avatar : 'https://ui-avatars.com/api/?name=' ~ host.prenom ~ '+' ~ host.nom ~ '&background=000&color=fff&size=256' }}" alt="{{ host.prenom }}" class="rounded-circle mx-auto mb-3 object-fit-cover shadow-sm border" style="width:140px;height:140px;">

						<h2 class="h4 fw-bold mb-1">{{ host.prenom }}
							{{ host.nom|first }}.</h2>
						<p class="text-muted small mb-4">Hôte sur CoLive depuis
							{{ host.dateCreationCompte|date('Y') }}</p>

						<div class="d-grid gap-2 mb-4">
							<a href="{{ path('app_contact_add', {id: host.id}) }}" class="btn btn-dark rounded-pill py-2 fw-bold">
								<i class="bi bi-chat-left-text me-2"></i>Contacter l'hôte
							</a>
						</div>

						<hr
						class="my-4 opacity-25">

						<!-- Score moyen -->
						<div class="bg-light rounded-4 p-4">
							<div class="h1 fw-bold text-dark mb-0" id="averageRating">--</div>
							<div
								class="d-flex justify-content-center my-2 text-warning fs-5" id="ratingStars">{# Rempli dynamiquement par JS #}
							</div>
							<p class="text-muted small mb-0" id="totalReviews">Chargement des avis...</p>
						</div>
					</div>
				</div>

				<!-- Colonne Droite : Liste des Avis -->
				<div class="col-lg-8">
					<div class="card border shadow-sm rounded-4 p-4">
						<div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
							<h3 class="h5 fw-bold mb-0">Ce que disent les voyageurs</h3>
							<span class="badge bg-primary rounded-pill px-3 py-2" id="reviewCount">0 avis</span>
						</div>

						<!-- Conteneur pour les avis injectés par JS -->
						<div class="row g-4" id="reviewsGrid">
							<div class="col-12 text-center py-5" id="reviews-loading">
								<div class="spinner-grow text-primary" role="status">
									<span class="visually-hidden">Chargement...</span>
								</div>
								<p class="mt-3 text-muted fw-medium">Récupération des commentaires...</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script src="{{ asset('js/host_reviews_index.js') }}"></script>
{% endblock %}
