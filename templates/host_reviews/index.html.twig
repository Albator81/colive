{% extends 'base.html.twig' %}

{% block title %}Avis de {{ host.prenom }}{% endblock %}

{% block body_data %}
    data-host-id="{{ host.id }}"
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}

<div class="bg-light min-vh-100 py-5">
    <div class="container">
        <div class="row">
            <!-- Profile Card -->
            <div class="col-lg-4 mb-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                    <img src="{{ host.avatar ? host.avatar : 'https://ui-avatars.com/api/?name=' ~ host.prenom ~ '+' ~ host.nom ~ '&background=000&color=fff&size=256' }}"
                         alt="{{ host.prenom }}"
                         class="rounded-circle mx-auto mb-3 object-fit-cover" style="width:120px;height:120px;">

                    <h1 class="h4 fw-bold mb-1">{{ host.prenom }} {{ host.nom }}</h1>
                    <p class="text-muted mb-3">Membre depuis {{ host.dateCreationCompte|date('Y') }}</p>

                    <a href="{{ path('app_contact_add', {id: host.id}) }}" class="btn btn-dark rounded-pill mb-4">
                        <i class="bi bi-envelope me-2"></i>Contacter
                    </a>

                    <div class="bg-light rounded-3 p-3">
                        <div class="h1 fw-bold" id="averageRating">...</div>
                        <div class="d-flex justify-content-center mb-2" id="ratingStars"></div>
                        <small class="text-muted" id="totalReviews">... avis reçus</small>
                    </div>
                </div>
            </div>

            <!-- Reviews -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="h5 fw-bold mb-0">Tous les avis</h2>
                        <span class="badge bg-dark rounded-pill p-2" id="reviewCount">... commentaires</span>
                    </div>

                    <div class="row g-3" id="reviewsGrid">
                        <div class="col-12 text-center py-4" id="reviews-loading">
                            <div class="spinner-border" role="status"></div>
                            <p class="mt-2 text-muted">Chargement des avis...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{ asset('js/host_reviews_index.js') }}"></script>
{% endblock %}
