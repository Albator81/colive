{% extends 'base.html.twig' %}

{% block title %}Avis de {{ host.prenom }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/host_reviews.css') }}">
{% endblock %}

{% block body %}
    <script>document.body.dataset.hostId = "{{ host.id }}";</script>

    <nav class="user-navbar">
        <a href="{{ path('app_home') }}" id="nav-logo">
            <span>C</span> CoLive
        </a>
        <div>
            {% if app.user %}
                <a href="{{ path('app_profile') }}" class="nav-user-pill">
                    {% if app.user.avatar %}
                        <img src="{{ app.user.avatar }}" alt="Avatar" class="nav-avatar-mini">
                    {% else %}
                        <img src="https://ui-avatars.com/api/?name={{ app.user.prenom }}+{{ app.user.nom }}&background=000&color=fff&size=256&font-size=0.33" alt="Avatar" class="nav-avatar-mini">
                    {% endif %}
                    <span>{{ app.user.prenom }}</span>
                </a>
            {% else %}
                <a href="{{ path("app_login") }}" class="login-btn">Se connecter</a>
            {% endif %}
        </div>
    </nav>

    <div class="page-container">

        <aside class="profile-card">
            <img src="{{ host.avatar ? host.avatar : 'https://ui-avatars.com/api/?name=' ~ host.prenom ~ '+' ~ host.nom ~ '&background=000&color=fff&size=256' }}"
                 alt="{{ host.prenom }}"
                 class="profile-avatar">

            <h1 class="profile-name">{{ host.prenom }} {{ host.nom }}</h1>
            <div class="profile-sub">Membre depuis {{ host.dateCreationCompte|date('Y') }}</div>

            <div class="contact-info-wrapper">
                <a href="{{ path('app_contact_add', {id: host.id}) }}" class="info-row">
                    <span class="info-icon">
                        <svg  xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#fff" viewBox="0 0 24 24">
                        <path d="m20.56,3.17c-.29-.2-.67-.23-.99-.08L2.57,11.1c-.35.17-.58.53-.57.92s.24.75.6.9l5.4,2.36v6.72l5.84-4.17,4.76,2.08c.13.06.26.08.4.08.18,0,.36-.05.52-.15.28-.17.46-.46.48-.79l1-15c.02-.35-.14-.69-.43-.89Zm-2.47,14.34l-5.21-2.28,3.12-6.23-7.65,4.25-2.93-1.28,13.47-6.34-.79,11.89Z"></path>
                        </svg>
                    </span>
                    <span class="info-text">Contacter</span>
                </a>
            </div>

            <div class="rating-box">
                <div class="rating-large" id="averageRating">...</div>
                <div class="rating-stars" id="ratingStars"></div>
                <div class="rating-count" id="totalReviews">... avis reçus</div>
            </div>
        </aside>

        <main class="content-card">
            <div class="content-header">
                <div class="content-title">Tous les avis</div>
                <div class="pill-badge" id="reviewCount">... commentaires</div>
            </div>

            <div class="reviews-grid" id="reviewsGrid">
                <div id="reviews-loading">Chargement des avis...</div>
            </div>
        </main>
    </div>

    <script src="{{ asset('js/host_reviews_index.js') }}"></script>
{% endblock %}
