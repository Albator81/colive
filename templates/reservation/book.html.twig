{% extends 'base.html.twig' %}

{% block title %}Réserver - {{ announce.titre }}{% endblock %}

{% block body_data %}
    data-unavailable-dates="{{ unavailableDates|default('[]')|escape('html_attr') }}"
    data-min-date="{{ minDateCalculated|default(announce.disponibiliteDebut)|date('Y-m-d') }}"
    data-max-date="{{ announce.disponibiliteFin|date('Y-m-d') }}"
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="container py-5" style="max-width:600px;">
        <a href="{{ path('app_announce_show', {'id': announce.id}) }}" class="btn btn-outline-dark rounded-pill mb-4 d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-2"></i>Retour à l'annonce
        </a>

        <div class="card border-0 shadow-lg rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <h1 class="h4 fw-bold mb-1">{{ announce.titre }}</h1>
                    <p class="text-muted mb-0">Jusqu'au {{ announce.disponibiliteFin|date('d F Y') }}</p>
                </div>
                <div class="text-end">
                    <span class="h3 fw-bold">{{ announce.prix }}€</span>
                    <span class="text-muted small">/ nuit</span>
                </div>
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            <div class="d-flex gap-2 mb-3">
                <div class="flex-fill p-3 border rounded-3" id="box_start" style="cursor:pointer;border-color:var(--bs-primary);">
                    <small class="text-muted d-block fw-bold text-uppercase">Arrivée</small>
                    <span class="fw-bold" id="text_start">Ajouter une date</span>
                </div>
                <div class="flex-fill p-3 border rounded-3" id="box_end" style="cursor:pointer;">
                    <small class="text-muted d-block fw-bold text-uppercase">Départ</small>
                    <span class="fw-bold" id="text_end">Ajouter une date</span>
                </div>
            </div>

            <div id="inline_calendar" class="mb-3"></div>

            <div class="d-none">
                {{ form_widget(form.dateDebut) }}
                {{ form_widget(form.dateFin) }}
            </div>

            <div class="text-danger small fw-bold mb-3">
                {{ form_errors(form.dateDebut) }}
                {{ form_errors(form.dateFin) }}
            </div>

            <div class="d-flex gap-2 align-items-center">
                <button type="button" class="btn btn-outline-secondary rounded-pill" id="btn_clear">Effacer</button>
                {{ form_widget(form.submit, {'attr': {'class': 'btn btn-dark btn-lg rounded-pill flex-fill'}, 'label': 'Confirmer la réservation'}) }}
            </div>

            {{ form_end(form) }}
        </div>

        <p class="text-center text-muted small mt-3 pb-5 mb-0">
            Votre réservation n'est pas encore confirmée. Vous ne serez débité qu'après validation.
        </p>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/fr.min.js"></script>
    <script src="{{ asset('js/reservation_book.js') }}"></script>
{% endblock %}
